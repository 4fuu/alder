#!/bin/sh
# Run the canonical checks from AGENTS.md and CONTRIBUTING.md.
#
# This is a thin wrapper: every command it runs is one of the canonical
# commands, with no extra flags, no filtering, and no substitutions. The
# artifact cache the compiler package tests use is on by default; set
# ALDER_TEST_CACHE=0 to rebuild everything.
#
# usage: ./check [--bootstrap] [--no-cache]
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
cd "$script_dir"

bootstrap=false
for arg in "$@"; do
    case "$arg" in
        --bootstrap) bootstrap=true ;;
        --no-cache) export ALDER_TEST_CACHE=0 ;;
        *)
            echo "usage: $0 [--bootstrap] [--no-cache]" >&2
            exit 2
            ;;
    esac
done

status=0

step() {
    name=$1
    shift
    printf '== %s\n' "$name"
    if "$@"; then
        printf '   ok: %s\n' "$name"
    else
        printf '   FAILED: %s\n' "$name" >&2
        status=1
    fi
}

# gofmt -l . must print nothing, so a non-empty result is a failure.
check_gofmt() {
    out=$(gofmt -l .)
    if [ -n "$out" ]; then
        echo "$out"
        return 1
    fi
    return 0
}

step "gofmt -l ." check_gofmt
step "go vet ./..." go vet ./...
step "gcc -fsyntax-only runtime/c/alder.c" \
    gcc -std=c11 -Wall -Wextra -Werror -pedantic -Wshadow -Wconversion \
    -fsyntax-only runtime/c/alder.c
step "go test ./... -count=1" go test ./... -count=1

if [ "$bootstrap" = true ]; then
    echo "== bootstrap/regenerate.sh (this takes about 21 minutes)"
    step "bootstrap/regenerate.sh" ./bootstrap/regenerate.sh
else
    echo "== bootstrap/regenerate.sh (skipped; pass --bootstrap to run it)"
fi

if [ "$status" -eq 0 ]; then
    echo "all canonical checks passed"
else
    echo "canonical checks failed" >&2
fi
exit "$status"
