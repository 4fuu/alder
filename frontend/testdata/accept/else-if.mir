fn @sum(%n: u64) -> u64 {
  local %total: u64
  local %i: u64

bb0:
  %v = const.get @lit.int.c0
  store local %total, %v
  %v0 = const.get @lit.int.c0
  store local %i, %v0
  jump bb_head

bb_head:
  %v1 = load local %i
  %v2 = int.lt %v1, %n
  branch %v2, bb_body, bb_join

bb_body:
  %v3 = load local %i
  %v4 = const.get @lit.int.c0
  %v5 = int.eq %v3, %v4
  branch %v5, bb_then, bb_else

bb_join:
  %v21 = load local %total
  return %v21

bb_then:
  %v6 = load local %total
  %v7 = const.get @lit.int.c2
  %v8 = int.add.checked %v6, %v7 else bb_fail
  store local %total, %v8
