enum Shape {
    Circle(I64),
    Square(I64),
    Dot,
}

fn area(s: Shape) -> I64 {
    return match s {
        Circle(r) => r * r,
        Square(w) => w * w,
        Dot => 0,
    };
}

fn main() -> I32 {
    if area(Circle(5)) != 25 {
        return 1;
    }
    if area(Dot) != 0 {
        return 2;
    }
    return 0;
}
