#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

packages=()

if ! command -v go >/dev/null 2>&1; then
  packages+=(golang-go)
fi

if ! command -v cc >/dev/null 2>&1; then
  packages+=(build-essential)
fi

if ((${#packages[@]} > 0)); then
  if ((EUID == 0)); then
    apt_get=(apt-get)
  else
    apt_get=(sudo apt-get)
  fi

  printf 'Installing missing toolchain packages: %s\n' "${packages[*]}"
  "${apt_get[@]}" update
  DEBIAN_FRONTEND=noninteractive "${apt_get[@]}" install -y "${packages[@]}"
else
  printf '%s\n' 'Required toolchains are already installed.'
fi

printf 'Go: %s\n' "$(go version)"
printf 'C compiler: %s\n' "$(cc --version | sed -n '1p')"
printf '%s\n' 'Aster orb setup complete.'
