#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

missing=()
go_bin="$HOME/.local/share/alder/go/bin/go"

if [[ ! -x "$go_bin" ]] || [[ "$($go_bin version)" != "go version go1.26.5 linux/amd64" ]]; then
  missing+=("Go 1.26.5")
fi
command -v cc >/dev/null 2>&1 || missing+=(cc)

if ((${#missing[@]} > 0)); then
  printf 'Missing required tools after orb resume: %s\n' "${missing[*]}" >&2
  printf '%s\n' 'Run .agents/setup to repair the orb.' >&2
  exit 1
fi

printf '%s\n' 'Alder orb prerequisites are available.'
