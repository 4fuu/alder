fn @i16add(%a: i16, %b: i16) -> i16 {
bb0:
  %r = int.add.checked %a, %b else bb_fail
  return %r
bb_fail:
  %z = const.get @zero_i16
  fail %z
}

fn @u16add(%a: u16, %b: u16) -> u16 {
bb0:
  %r = int.add.checked %a, %b else bb_fail
  return %r
bb_fail:
  %z = const.get @zero_u16
