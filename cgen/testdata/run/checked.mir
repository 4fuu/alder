bb0:
  %sum = int.add.checked %a, %b else bb_fail
  %diff = int.sub.checked %sum, %b else bb_fail
  %prod = int.mul.checked %diff, %a else bb_fail
  %quot = int.div.checked %prod, %b else bb_fail
  %shl = int.shl.checked %quot, %b else bb_fail
  %shr = int.shr.checked %shl, %b else bb_fail
