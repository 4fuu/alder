mir 6

fn @f64_add(%a: f64, %b: f64) -> f64 {
entry:
  %r = float.add %a, %b
  return %r
}

fn @f64_sub(%a: f64, %b: f64) -> f64 {
entry:
  %r = float.sub %a, %b
  return %r
}

