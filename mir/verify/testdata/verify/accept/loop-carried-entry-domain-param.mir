mir 5

const @zero_u64: u64 = 0
const @true_v: bool = true

fn @f(%root: domain_handle, %again: bool) {
bb0:
  %d = domain.create %root
  %v = vec.new vec(u64)
  %s = vec.as_slice %v
  jump loop(%s)

loop(%sequence: slice(u64)):
  %c = const.get @true_v
  branch %c, loop(%sequence), done

done:
  domain.destroy %d
  return
}
