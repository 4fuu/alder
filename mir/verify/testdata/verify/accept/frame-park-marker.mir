mir 6

# The park marker is a compiler-recognized runtime binding. A step that
# registers an external wakeup and returns park is accepted exactly like the
# Alder-written verifier accepts the lowered park module.

const @zero: u64 = 0

enum @__alder_step.status {
  done
  call
  park
  cancelled
}

enum @__alder_step.state.wait.Evented {
  entry
  resume0
}

type @__alder_step.frame.wait.Evented {
  state: @__alder_step.state.wait.Evented
  out: u64
}

binding @runtime "alder.h" {
  c_fn @task_cancelled = "alder_task_cancelled"() -> bool
  c_fn @park = "alder_task_park"() -> unit
}

fn @__alder_step.run.wait.Evented(%d: domain_handle, %frame: safe_mut(@__alder_step.frame.wait.Evented), %frame_owner: domain_handle) -> @__alder_step.status {
bb0:
  %state = load field(deref %frame, state)
  switch %state {
    entry -> bb_entry
    resume0 -> bb_resume0
  }

bb_entry:
  %cancelled = c.call.unsafe @runtime.task_cancelled()
  branch %cancelled, bb_cancel0, bb_park

bb_park:
  c.call.unsafe @runtime.park()
  %resume = enum.construct @__alder_step.state.wait.Evented, resume0
  store field(deref %frame, state), %resume
  %park = enum.construct @__alder_step.status, park
  return %park

bb_resume0:
  %cancelled0 = c.call.unsafe @runtime.task_cancelled()
  branch %cancelled0, bb_cancel1, bb_done

bb_done:
  %zero = const.get @zero
  store field(deref %frame, out), %zero
  %done = enum.construct @__alder_step.status, done
  return %done

bb_cancel0:
  %st0 = enum.construct @__alder_step.status, cancelled
  return %st0

bb_cancel1:
  %st1 = enum.construct @__alder_step.status, cancelled
  return %st1
}
