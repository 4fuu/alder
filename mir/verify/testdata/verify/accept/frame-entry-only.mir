mir 6

# A step whose activation completes without suspending. The frame still has
# the pinned state/p0/out shape, the dispatch switch has one case, and done
# observes a definitely initialized out field.

const @three: u64 = 3

enum @__alder_step.status {
  done
  call
  park
  cancelled
}

enum @__alder_step.state.once.Evented {
  entry
}

type @__alder_step.frame.once.Evented {
  state: @__alder_step.state.once.Evented
  p0: u64
  out: u64
}

fn @__alder_step.run.once.Evented(%d: domain_handle, %frame: safe_mut(@__alder_step.frame.once.Evented), %frame_owner: domain_handle) -> @__alder_step.status {
bb0:
  %state = load field(deref %frame, state)
  switch %state {
    entry -> bb_entry
  }

bb_entry:
  %p0 = load field(deref %frame, p0)
  %three = const.get @three
  %total = int.add.checked %p0, %three else bb_overflow
  store field(deref %frame, out), %total
  %done = enum.construct @__alder_step.status, done
  return %done

bb_overflow:
  panic
}
