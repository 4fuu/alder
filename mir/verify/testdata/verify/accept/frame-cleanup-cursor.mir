mir 6

# A suspending cleanup cursor: the frame-resident scope is anchored in s0 and
# registered in c0. The teardown suspends with a call handoff (cleanup0) or a
# park (cleanup1); both cleanup states follow the resume dispatch, save/load,
# and cancellation rules.

const @one: u64 = 1
const @zero: u64 = 0

enum @__alder_step.status {
  done
  call
  park
  cancelled
}

enum @__alder_step.state.worker.Evented {
  entry
  cleanup0
  cleanup1
}

enum @__alder_step.state.leaf.Evented {
  entry
}

type @__alder_step.frame.leaf.Evented {
  state: @__alder_step.state.leaf.Evented
  out: u64
}

type @__alder_step.frame.worker.Evented {
  state: @__alder_step.state.worker.Evented
  p0: u64
  p1: bool
  x0: safe_mut(@__alder_step.frame.leaf.Evented)
  y0: domain_handle
  c0: cleanup_id
  s0: cleanup_scope
  out: u64
}

binding @runtime "alder.h" {
  c_fn @task_cancelled = "alder_task_cancelled"() -> bool
}

fn @hook(%owner: u64) {
bb0:
  return
}

fn @__alder_step.run.leaf.Evented(%d: domain_handle, %frame: safe_mut(@__alder_step.frame.leaf.Evented), %frame_owner: domain_handle) -> @__alder_step.status {
bb0:
  %state = load field(deref %frame, state)
  switch %state {
    entry -> bb_entry
  }

bb_entry:
  %cancelled = c.call.unsafe @runtime.task_cancelled()
  branch %cancelled, bb_cancel, bb_done

bb_done:
  %zero = const.get @zero
  store field(deref %frame, out), %zero
  %done = enum.construct @__alder_step.status, done
  return %done

bb_cancel:
  %st = enum.construct @__alder_step.status, cancelled
  return %st
}

fn @__alder_step.run.worker.Evented(%d: domain_handle, %frame: safe_mut(@__alder_step.frame.worker.Evented), %frame_owner: domain_handle) -> @__alder_step.status {
bb0:
  %state = load field(deref %frame, state)
  switch %state {
    entry -> bb_entry
    cleanup0 -> bb_cleanup0
    cleanup1 -> bb_cleanup1
  }

bb_entry:
  %cancelled = c.call.unsafe @runtime.task_cancelled()
  branch %cancelled, bb_cancel0, bb_select

bb_select:
  %p1 = load field(deref %frame, p1)
  branch %p1, bb_call, bb_park

bb_call:
  %p0 = load field(deref %frame, p0)
  %one = const.get @one
  %child_domain = domain.create %frame_owner
  %child = alloc %child_domain, @__alder_step.frame.leaf.Evented, %one
  %entry = enum.construct @__alder_step.state.leaf.Evented, entry
  store field(deref %child, state), %entry
  %resume = enum.construct @__alder_step.state.worker.Evented, cleanup0
  store field(deref %frame, state), %resume
  store field(deref %frame, x0), %child
  store field(deref %frame, y0), %child_domain
  %scope = cleanup.scope.begin
  store field(deref %frame, s0), %scope
  %id = cleanup.push %scope, @hook, (%p0) place field(deref %frame, p0)
  store field(deref %frame, c0), %id
  %call = enum.construct @__alder_step.status, call
  return %call

bb_park:
  %p0p = load field(deref %frame, p0)
  %park_state = enum.construct @__alder_step.state.worker.Evented, cleanup1
  store field(deref %frame, state), %park_state
  %scope0 = cleanup.scope.begin
  store field(deref %frame, s0), %scope0
  %id0 = cleanup.push %scope0, @hook, (%p0p) place field(deref %frame, p0)
  store field(deref %frame, c0), %id0
  %park = enum.construct @__alder_step.status, park
  return %park

bb_cleanup0:
  %cancelled0 = c.call.unsafe @runtime.task_cancelled()
  branch %cancelled0, bb_cancel1, bb_after0

bb_after0:
  %scope1 = cleanup.scope.begin
  store field(deref %frame, s0), %scope1
  %child0 = load field(deref %frame, x0)
  %child_domain0 = load field(deref %frame, y0)
  %id1 = load field(deref %frame, c0)
  %saved0 = load field(deref %frame, s0)
  domain.destroy %child_domain0
  cleanup.disarm %id1
  cleanup.scope.run %scope1
  cleanup.scope.end %scope1
  %p0b = load field(deref %frame, p0)
  store field(deref %frame, out), %p0b
  %done0 = enum.construct @__alder_step.status, done
  return %done0

bb_cleanup1:
  %cancelled1 = c.call.unsafe @runtime.task_cancelled()
  branch %cancelled1, bb_cancel2, bb_after1

bb_after1:
  %scope2 = cleanup.scope.begin
  store field(deref %frame, s0), %scope2
  %id2 = load field(deref %frame, c0)
  %saved1 = load field(deref %frame, s0)
  cleanup.disarm %id2
  cleanup.scope.run %scope2
  cleanup.scope.end %scope2
  %p0c = load field(deref %frame, p0)
  store field(deref %frame, out), %p0c
  %done1 = enum.construct @__alder_step.status, done
  return %done1

bb_cancel0:
  %st0 = enum.construct @__alder_step.status, cancelled
  return %st0

bb_cancel1:
  %st1 = enum.construct @__alder_step.status, cancelled
  return %st1

bb_cancel2:
  %scope3 = cleanup.scope.begin
  store field(deref %frame, s0), %scope3
  %id3 = load field(deref %frame, c0)
  %saved2 = load field(deref %frame, s0)
  cleanup.disarm %id3
  cleanup.scope.run %scope3
  cleanup.scope.end %scope3
  %st2 = enum.construct @__alder_step.status, cancelled
  return %st2
}
